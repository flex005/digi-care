{
  "name": "digi-care",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm run icons",
    "predev": "npm run icons",
    "dev": "vite",
    "prebuild": "npm run icons",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/icons/build-icons.mjs",
    "icons:check": "node scripts/icons/build-icons.mjs --check",
    "typecheck": "tsc -b",
    "lint": "npm run lint:es && npm run lint:css && npm run lint:hatch && npm run lint:tel && npm run lint:plurals && npm run lint:selectors && npm run lint:instants && npm run lint:dashes && npm run lint:losses && npm run lint:svg",
    "lint:es": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:hatch": "node scripts/check-hatch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run icons:check && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky",
    "lint:tel": "node scripts/check-tel-links.mjs",
    "lint:plurals": "node scripts/check-plurals.mjs",
    "lint:selectors": "node scripts/check-selector-specificity.mjs",
    "lint:instants": "node scripts/check-instant-kinds.mjs",
    "lint:dashes": "node scripts/check-em-dashes.mjs",
    "lint:losses": "node scripts/check-session-losses.mjs",
    "lint:svg": "node scripts/check-svg-portable.mjs",
    "export:figma": "npm run build && node scripts/export/export-figma.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.css": "stylelint --fix",
    "*.{ts,tsx,css,json}": "prettier --write"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "date-fns": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
